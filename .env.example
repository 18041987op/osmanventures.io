# Contact form (Resend) — required for /api/contact to send emails.
RESEND_API_KEY=

# Optional. Defaults to osman@osmanventures.io
CONTACT_TO_EMAIL=

# Optional. Must be an address on a domain verified in Resend.
# While testing you can use Resend's shared sender: onboarding@resend.dev
# Example for production: "Osman Ventures <hello@osmanventures.io>"
CONTACT_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────
# Osman Ventures HQ — server-only secure access
# Do not prefix these variables with NEXT_PUBLIC_.
# Use a dedicated Supabase project for HQ production data.
# ─────────────────────────────────────────────────────────────
HQ_SUPABASE_URL=
HQ_SUPABASE_ANON_KEY=

# Comma-separated allowlist. A valid Supabase Auth user must also exist.
# Initial example: osman@osmanventures.io
HQ_ALLOWED_EMAILS=

# Generate at least 32 random bytes. Example command:
# openssl rand -base64 48
HQ_SESSION_SECRET=

# Required later for invite management, secure server mutations, and audit logging.
# Never expose this value in browser code.
HQ_SUPABASE_SERVICE_ROLE_KEY=
